# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/online_judge

# Message Queue Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_32char_minimum
JWT_EXPIRES_IN=24h

# Docker Sandbox Resource Limits
SANDBOX_DEFAULT_TIME_LIMIT_MS=1000
SANDBOX_DEFAULT_MEMORY_LIMIT_MB=256
SANDBOX_MAX_CODE_SIZE_BYTES=65536
